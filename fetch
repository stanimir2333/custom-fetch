                t1,t2 = l1>128, l2>128
                ch = "\u2588" if (t1 and t2) else ("\u2580" if t1 else ("\u2584" if t2 else " "))
                line.append(ch)
        print("".join(line))
elif mode == "full":
    pw=w; ph=max(1, round(w*oh/ow*0.5))
    px=scale_nearest(rows,ow,oh,pw,ph)
    for y in range(ph):
        line=[]
        for x in range(pw):
            r,g,b=px[y][x]
            if use_color: line.append(f"\x1b[38;2;{r};{g};{b}m\u2588\x1b[0m")
            else:
                lum=0.2126*r+0.7152*g+0.0722*b
                line.append(charset[int(lum/255*(len(charset)-1))])
        print("".join(line))
else:
    pw=w; ph=max(1, round(w*oh/ow*0.5))
    px=scale_nearest(rows,ow,oh,pw,ph)
    n=len(charset)
    for y in range(ph):
        line=[]
        for x in range(pw):
            r,g,b=px[y][x]
            lum=0.2126*r+0.7152*g+0.0722*b
            ch=charset[int(lum/255*(n-1))]
            if use_color: line.append(f"\x1b[38;2;{r};{g};{b}m{ch}\x1b[0m")
            else: line.append(ch)
        print("".join(line))
