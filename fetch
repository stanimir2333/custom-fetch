}

# stdlib renderer: reads PPM (P6) from a file, scales + renders. No Pillow needed.
# (takes a file path — not stdin — because the python code itself arrives via heredoc stdin)
render_ppm_file() {
  # args: ppmfile width mode charset color
  local ppmfile="$1" w="$2" mode="$3" cs="$4" col="$5"
  python3 - "$ppmfile" "$w" "$mode" "$cs" "$col" <<'PYEOF'
import sys
ppmpath, w, mode, charset, col = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4], sys.argv[5]
use_color = (col == "on")
with open(ppmpath, 'rb') as f:
    data = f.read()
# --- parse P6 PPM ---
def parse_ppm(d):
    # returns (W,H,pixels list of rows of (r,g,b))
    i = 0
    n = len(d)
    def next_token():
        nonlocal i
        while i < n:
            if d[i:i+1] == b'#':
                while i < n and d[i:i+1] != b'\n': i += 1
                continue
            if chr(d[i]) in ' \t\n\r':
                i += 1; continue
            break
        j = i
        while j < n and chr(d[j]) not in ' \t\n\r': j += 1
        tok = d[i:j].decode('ascii'); i = j
        return tok
    magic = next_token()
    if magic not in ('P6',):
        print(f"fetch: unsupported pipe format {magic}", file=sys.stderr); sys.exit(3)
    W = int(next_token()); H = int(next_token()); mx = int(next_token())
    i += 1  # single whitespace after maxval
    if mx != 255:
        print("fetch: only maxval 255 supported", file=sys.stderr); sys.exit(3)
    need = W*H*3
    raw = d[i:i+need]
    if len(raw) < need:
        print("fetch: truncated image data", file=sys.stderr); sys.exit(3)
    rows = []
    p = 0
    for y in range(H):
        row = []
        for x in range(W):
            row.append((raw[p], raw[p+1], raw[p+2])); p += 3
        rows.append(row)
    return W, H, rows
ow, oh, rows = parse_ppm(data)
def scale_nearest(rows, ow, oh, pw, ph):
    out = []
    for y in range(ph):
        sy = min(oh-1, int(y*oh/ph))
