            cur = None
            for x in range(pw):
                r,g,b = px[y][x]
                ch = charset[int((0.2126*r+0.7152*g+0.0722*b)/255*(nn2-1))]
                if use_color:
                    key = (r,g,b)
                    if key != cur:
                        parts.append(f"\x1b[38;2;{r};{g};{b}m")
                        cur = key
                    parts.append(ch)
                else:
                    parts.append(ch)
