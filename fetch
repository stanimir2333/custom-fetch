# Full animated playback: prerenders combined (art+info) screens, then loops.
# Args: image_file. Uses globals WIDTH/MODE/CHARSET/COLOR/SHOW_INFO/GAP/FPS/SPEED/LOOPS.
run_animated_image() {
  local file="$1"
  local col="$COLOR"; [[ "$MODE" == "mono" ]] && col="off"
  local tmpdir; tmpdir="$(mktemp -d)"
  local n_frames=0 rendered=0
  if have python3 && python_has_pil; then
    if render_animated_pil "$file" "$WIDTH" "$MODE" "$CHARSET" "$col" "$tmpdir" "$FPS"; then
      n_frames="$(cat "$tmpdir/count.txt")"; rendered=1
    else
      rc=$?
      if [[ $rc -eq 5 ]]; then rm -rf "$tmpdir"; return 5; fi  # static
      # fall through to ffmpeg attempt on other errors
    fi
  fi
  if (( rendered == 0 )); then
    if have ffmpeg && have python3; then
      if render_animated_ffmpeg "$file" "$WIDTH" "$MODE" "$CHARSET" "$col" "$tmpdir" "$FPS"; then
        n_frames="$(cat "$tmpdir/count.txt")"; rendered=1
      else
        rc=$?
        rm -rf "$tmpdir"
        if [[ $rc -eq 5 ]]; then return 5; fi
        return $rc
      fi
    else
      rm -rf "$tmpdir"; return 5
    fi
  fi
  if (( n_frames <= 1 )); then rm -rf "$tmpdir"; return 5; fi
  dbg "animated render: $n_frames frames (fps=${FPS:-native} speed=${SPEED:-1})"

  # frame delays (ms) → microseconds int for drift-free pacing.
  # Durations already preserve total speed (FPS resamples via interpolation).
  # --speed scales them (2 = twice as fast).
  local speed="${SPEED:-1}"
  local -a DELAY_US=()
  # single awk for all frames (1 fork, not N): clamp tiny native delays, apply speed, min 10ms
  if [[ -z "$FPS" ]]; then
    mapfile -t DELAY_US < <(awk -v s="$speed" '{m=$1+0; if(m==""||m<=0)m=100; if(m<20)m=100; d=m*1000/s; if(d<10000)d=10000; printf "%d\n", d}' "$tmpdir/durations.txt")
  else
    mapfile -t DELAY_US < <(awk -v s="$speed" '{m=$1+0; if(m==""||m<=0)m=100; d=m*1000/s; if(d<10000)d=10000; printf "%d\n", d}' "$tmpdir/durations.txt")
  fi

  # static side info (if any)
  local -a INFO=()
  local n_info=0
  if [[ "$SHOW_INFO" != "off" ]]; then
    build_info_lines
    INFO=("${INFO_LINES[@]}")
    n_info=${#INFO[@]}
  fi

  # prerender combined screens then load to memory (zero forks per frame in loop)
  local screens_dir="$tmpdir/screens"
  mkdir -p "$screens_dir"
  local gap; gap="$(printf '%*s' "$GAP" '')"
  local first_frame; first_frame="$(printf '%s/frame_%03d.txt' "$tmpdir" 0)"
  local art_h; art_h="$(wc -l < "$first_frame" | tr -d ' ')"
  local screen_h=0
  if [[ "$SHOW_INFO" == "off" ]]; then
    local f
    for ((f=0; f<n_frames; f++)); do
      cp "$(printf '%s/frame_%03d.txt' "$tmpdir" "$f")" "$(printf '%s/screen_%03d.txt' "$screens_dir" "$f")"
    done
    screen_h="$art_h"
  else
    local total=$(( art_h > n_info ? art_h : n_info ))
    screen_h="$total"
    local f ii a inf pad
    for ((f=0; f<n_frames; f++)); do
      local frame_file; frame_file="$(printf '%s/frame_%03d.txt' "$tmpdir" "$f")"
      local -a ART_F=()
      mapfile -t ART_F < "$frame_file"
      local out; out="$(printf '%s/screen_%03d.txt' "$screens_dir" "$f")"
      : > "$out"
      for ((ii=0; ii<total; ii++)); do
        a=""; inf=""
        (( ii < art_h )) && a="${ART_F[ii]:-}"
        (( ii < n_info )) && inf="${INFO[ii]:-}"
        if (( WIDTH == 0 )); then
          printf '%b\n' "$inf" >> "$out"
        elif [[ -z "$a" ]]; then
          pad="$(printf '%*s' "$WIDTH" '')"
          if [[ -z "$inf" ]]; then printf '\n' >> "$out"; else printf '%s%s%b\n' "$pad" "$gap" "$inf" >> "$out"; fi
        else
          if [[ -z "$inf" ]]; then printf '%b\n' "$a" >> "$out"
          else printf '%b%s%b\n' "$a" "$gap" "$inf" >> "$out"; fi
        fi
      done
    done
  fi

  # load all screens to memory: playback then uses only builtins + 1 sleep fork
  local -a SCREENS=()
  local f
  for ((f=0; f<n_frames; f++)); do
    SCREENS[f]="$(cat "$(printf '%s/screen_%03d.txt' "$screens_dir" "$f")")"
  done

  local HIDE=$'\e[?25l' SHOW=$'\e[?25h'
  printf '%s' "$HIDE"
  # shellcheck disable=SC2064
  trap "printf '\e[?25h'; rm -rf \"$tmpdir\"; exit 0" INT TERM HUP

  # drift-free pacing via EPOCHREALTIME (builtin, no forks). Only sleep() forks.
  # Frame-skipping video-player style: if terminal is slower than target fps,
  # skip ahead to the frame due NOW instead of playing every frame in slow motion.
  local now_us next_us sleep_s i l
  now_us=${EPOCHREALTIME/./}
  next_us=$((10#$now_us))

  # cumulative offsets for skipping (CUM[0]=0, CUM[i]=start time of frame i)
  local -a CUM=()
  CUM[0]=0
  for ((i=0; i<n_frames; i++)); do
    CUM[i+1]=$((CUM[i] + 10#${DELAY_US[i]:-100000}))
  done
  local total_us=${CUM[n_frames]:-100000}

  sleep_until_next() {
    # $1 = deadline in us; sleeps remainder; returns 0 slept, 1 already late
    local deadline=$1 now sleep_u
    now=${EPOCHREALTIME/./}
    sleep_u=$((deadline - 10#$now))
    if ((sleep_u > 0)); then
      printf -v sleep_s '%d.%06d' $((sleep_u/1000000)) $((sleep_u%1000000))
      sleep "$sleep_s"
      return 0
    fi
    return 1
  }

  # first==1 → no cursor move (first draw); else atomic move+redraw in one write
  local first_draw=1
  show_next() {
    if ((first_draw)); then
      printf '%s\n' "${SCREENS[$1]}"
      first_draw=0
    else
      printf '\e[%dA%s\n' "$screen_h" "${SCREENS[$1]}"
    fi
  }

  if (( LOOPS == 0 )); then
    # infinite: keep global timeline, skip frames when terminal can't keep up
    local pass_start=$next_us idx now elapsed target
    while :; do
      now=${EPOCHREALTIME/./}
      # if >1s behind timeline (terminal hung), restart live instead of bursting
      if (((10#$now - pass_start) > 1000000)); then pass_start=$((10#$now)); fi
      # find frame due now within this pass
      now=${EPOCHREALTIME/./}
      elapsed=$((10#$now - pass_start))
      idx=0
      while ((idx+1 < n_frames && CUM[idx+1] <= elapsed)); do idx=$((idx+1)); done
      show_next "$idx"
      if ((idx+1 >= n_frames)); then
        # wait out last frame's duration, then wrap (skips if terminal is slow)
        target=$((pass_start + total_us))
        next_us=$target
        sleep_until_next "$target"
        pass_start=$((pass_start + total_us))
        continue
      fi
      target=$((pass_start + CUM[idx+1]))
      next_us=$target
      sleep_until_next "$target"
    done
  else
    # finite: LOOPS passes back-to-back on one timeline (no gap drift)
    local pass_start=$next_us p idx now elapsed target
    local dbg_shown=0 dbg_skipped=0 dbg_prev=-1 dbg_t0=0 dbg_t1=0
    now=${EPOCHREALTIME/./}; dbg_t0=$((10#$now))
    for ((p=0; p<LOOPS; p++)); do
      if ((p > 0)); then
        pass_start=$((pass_start + total_us))
        now=${EPOCHREALTIME/./}
        if (((10#$now - pass_start) > 1000000)); then pass_start=$((10#$now)); fi
        dbg_prev=-1
      fi
      while :; do
        now=${EPOCHREALTIME/./}
        elapsed=$((10#$now - pass_start))
        idx=0
        while ((idx+1 < n_frames && CUM[idx+1] <= elapsed)); do idx=$((idx+1)); done
        show_next "$idx"
        dbg_shown=$((dbg_shown+1))
        if ((dbg_prev >= 0 && idx > dbg_prev+1)); then dbg_skipped=$((dbg_skipped + idx-dbg_prev-1)); fi
        dbg_prev=$idx
        if ((idx+1 >= n_frames)); then break; fi
        target=$((pass_start + CUM[idx+1]))
        next_us=$target
        sleep_until_next "$target"
      done
      if ((p == LOOPS-1)); then break; fi
      # wait out last frame before next pass (keeps inter-pass gap exact;
      # skipped automatically if terminal is slow)
      target=$((pass_start + total_us))
      next_us=$target
      sleep_until_next "$target"
    done
    now=${EPOCHREALTIME/./}; dbg_t1=$((10#$now))
    if [[ -n "${FETCH_DEBUG:-}" ]]; then
      local wall_us=$((dbg_t1-dbg_t0)) timeline_us=$((total_us*LOOPS))
      local eff="?"
      if ((wall_us > 0)); then eff=$(awk -v s="$dbg_shown" -v w="$wall_us" 'BEGIN{printf "%.1f", s*1000000/w}'); fi
      dbg "playback: shown $dbg_shown/$((n_frames*LOOPS)) frames (skipped $dbg_skipped) in $((wall_us/1000))ms wall vs $((timeline_us/1000))ms timeline (effective ${eff}fps)"
    fi
    printf '%s' "$SHOW"
    trap - INT TERM HUP
    rm -rf "$tmpdir"
    return 0
  fi
}

# main dispatcher: prints ascii art to stdout, returns 0 on success
print_image_ascii() {
  local file="$1"
  local ext="${file##*.}"; ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
  local col="$COLOR"; [[ "$MODE" == "mono" ]] && col="off"

  # 1) Pillow — best path, all formats
  if have python3 && python_has_pil; then
    if render_image_pil "$file" "$WIDTH" "$MODE" "$CHARSET" "$col"; then return 0; fi
    rc=$?; [[ $rc -eq 10 ]] || return $rc   # real render error: don't silently fall through
  fi

  # 2) ImageMagick / ffmpeg -> PPM file -> stdlib renderer (handles JPG+PNG, no Pillow)
  if have python3; then
    local _ppm=""; _ppm="$(mktemp --suffix=.ppm 2>/dev/null || mktemp)"
    # shellcheck disable=SC2064
    trap "rm -f '$_ppm'" RETURN
    if have magick; then
      if magick "$file" -resize '320x320>' "ppm:$_ppm" 2>/dev/null && render_ppm_file "$_ppm" "$WIDTH" "$MODE" "$CHARSET" "$col"; then rm -f "$_ppm"; trap - RETURN; return 0; fi
    elif have convert; then
      # cap source at 320px to keep things fast; stdlib python rescales to WIDTH
      if convert "$file" -resize '320x320>' "ppm:$_ppm" 2>/dev/null && render_ppm_file "$_ppm" "$WIDTH" "$MODE" "$CHARSET" "$col"; then rm -f "$_ppm"; trap - RETURN; return 0; fi
    fi
    if have ffmpeg; then
      if ffmpeg -y -loglevel error -i "$file" -vframes 1 -vf "scale='min(320\,iw)':-1" -f image2 -vcodec ppm "$_ppm" 2>/dev/null && render_ppm_file "$_ppm" "$WIDTH" "$MODE" "$CHARSET" "$col"; then rm -f "$_ppm"; trap - RETURN; return 0; fi
    fi
    rm -f "$_ppm"; trap - RETURN
  fi

  # 3) pure-stdlib PNG (zero deps)
  if [[ "$ext" == "png" ]] && have python3; then
    if render_png_stdlib "$file" "$WIDTH" "$MODE" "$CHARSET" "$col"; then return 0; fi
    return $?
  fi

  # 4) external ascii tools as last resort
  if have chafa; then
    local args=(--format symbols --symbols block --size "${WIDTH}x")
    [[ "$col" == "off" ]] && args+=(--color-space mono)
    chafa "${args[@]}" "$file" 2>/dev/null && return 0
  fi
  if have jp2a; then
    [[ "$col" == "off" ]] && jp2a --width="$WIDTH" "$file" 2>/dev/null && return 0
    jp2a --colors --width="$WIDTH" "$file" 2>/dev/null && return 0
  fi

  die "cannot decode '$file'. Install one of: python3-pillow, imagemagick, ffmpeg."
}

# =====================================================================
# MAIN RENDER
# =====================================================================
main() {
  local -a ART=()
  local art_width="$WIDTH"
  local tmp rc

  if [[ -n "$IMAGE" && "$SHOW_INFO" != "off" || -n "$IMAGE" ]]; then :; fi

  if [[ -n "$IMAGE" ]]; then
    # animated GIF / WebP / APNG → terminal animation (unless --static / piped)
    if should_animate "$IMAGE"; then
      run_animated_image "$IMAGE"
      rc=$?
      if [[ $rc -eq 0 ]]; then return 0; fi
      if [[ $rc -ne 5 ]]; then exit "$rc"; fi
      dbg "static fallback for $IMAGE (single-frame or backend missing)"
      # rc==5 → not actually animated / backend missing: fall through to static
    fi
    # static: capture rendered lines preserving ANSI
    tmp="$(mktemp)"
    if ! print_image_ascii "$IMAGE" > "$tmp"; then rm -f "$tmp"; exit 1; fi
    mapfile -t ART < "$tmp"
    rm -f "$tmp"
    art_width="$WIDTH"
  elif [[ -n "$TEXT_LOGO" && "$TEXT_LOGO" != "__none__" ]]; then
    tmp="$(mktemp)"
    get_text_logo "$TEXT_LOGO" > "$tmp"
    mapfile -t ART < "$tmp"
    rm -f "$tmp"
    # visible width of text logo = longest line without ANSI
    art_width=0
    for l in "${ART[@]}"; do
      plain="$(printf '%s' "$l" | sed -e 's/\x1b\[[0-9;]*m//g')"
      (( ${#plain} > art_width )) && art_width=${#plain}
    done
  elif [[ "${TEXT_LOGO:-}" == "__none__" ]]; then
    ART=(); art_width=0
  else
    tmp="$(mktemp)"
    get_text_logo "$(detect_distro_logo)" > "$tmp"
    mapfile -t ART < "$tmp"
    rm -f "$tmp"
    art_width=0
    for l in "${ART[@]}"; do
      plain="$(printf '%s' "$l" | sed -e 's/\x1b\[[0-9;]*m//g')"
      (( ${#plain} > art_width )) && art_width=${#plain}
    done
  fi

  if [[ "$SHOW_INFO" == "off" ]]; then
    printf '%s\n' "${ART[@]}"
    return 0
  fi

  build_info_lines

  local n_art=${#ART[@]} n_info=${#INFO_LINES[@]}
  local n=$(( n_art > n_info ? n_art : n_info ))
  local gap; gap="$(printf '%*s' "$GAP" '')"
  local i a inf pad
  for ((i=0; i<n; i++)); do
    a=""; inf=""
    (( i < n_art )) && a="${ART[i]}"
    (( i < n_info )) && inf="${INFO_LINES[i]}"
    if (( art_width == 0 )); then
      printf '%b\n' "$inf"
    elif [[ -z "$a" ]]; then
      pad="$(printf '%*s' "$art_width" '')"
      if [[ -z "$inf" ]]; then printf '\n'; else printf '%s%s%b\n' "$pad" "$gap" "$inf"; fi
    else
      if [[ -z "$inf" ]]; then printf '%b\n' "$a"
      else printf '%b%s%b\n' "$a" "$gap" "$inf"; fi
    fi
  done
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
