# =====================================================================
# IMAGE → ASCII (embedded python, multi-backend)
# =====================================================================
render_image_pil() {
  # args: file width mode charset color(on/off)
  local file="$1" w="$2" mode="$3" cs="$4" col="$5"
  python3 - "$file" "$w" "$mode" "$cs" "$col" <<'PYEOF'
import sys
try:
    from PIL import Image
except ImportError:
    sys.exit(10)
path, w, mode, charset, col = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4], sys.argv[5]
use_color = (col == "on")
im = Image.open(path)
# composite transparency onto black
if im.mode in ("RGBA", "LA"):
    bg = Image.new("RGB", im.size, (0, 0, 0))
    bg.paste(im.convert("RGB") if im.mode=="RGBA" else im.convert("RGB"), mask=im.split()[-1])
    im = bg
else:
    im = im.convert("RGB")
ow, oh = im.size
if ow <= 0 or oh <= 0:
    sys.exit(2)
if mode == "half":
    pw = w
    ph = max(1, round(w * oh / ow))
    im = im.resize((pw, ph), Image.LANCZOS)
    px = im.load()
    for y in range(0, ph, 2):
        line = []
        for x in range(pw):
            r1,g1,b1 = px[x, y]
            if y+1 < ph:
                r2,g2,b2 = px[x, y+1]
            else:
                r2,g2,b2 = (0,0,0)
            if use_color:
                line.append(f"\x1b[38;2;{r1};{g1};{b1};48;2;{r2};{g2};{b2}m\u2580\x1b[0m")
            else:
                l1 = 0.2126*r1+0.7152*g1+0.0722*b1
                l2 = 0.2126*r2+0.7152*g2+0.0722*b2
                t1, t2 = l1>128, l2>128
                if t1 and t2: ch="\u2588"
                elif t1: ch="\u2580"
                elif t2: ch="\u2584"
                else: ch=" "
                line.append(ch)
        print("".join(line))
elif mode == "full":
    pw = w
    ph = max(1, round(w * oh / ow * 0.5))
    im = im.resize((pw, ph), Image.LANCZOS)
    px = im.load()
    for y in range(ph):
        line=[]
        for x in range(pw):
