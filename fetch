#!/usr/bin/env bash
#
# custom-fetch — fastfetch-like system info + JPEG/PNG → ASCII art (no setup)
#
# Usage:
#   ./fetch --image photo.jpg
#   ./fetch -i logo.png -w 50 --mode half
#   ./fetch --image ~/Pictures/wallpaper.jpg --ascii
#   ./fetch -i anim.gif --animate        # animated GIF/WebP playback (loops)
#   ./fetch -i anim.gif --once --fps 20  # smoother, same speed, play once
#   ./fetch -i anim.gif --once --fps 20 --speed 2  # smoother + 2x fast
#   ./fetch --logo arch            # text logo only (no image)
#   ./fetch --info-only            # no logo/image
#
# Image backends (auto-detected, in order):
#   1) python3 + Pillow (best, handles JPG/PNG/WebP/GIF/BMP, truecolor)
#   2) ImageMagick (convert/magick) or ffmpeg -> PPM -> stdlib python renderer
#   3) pure-python stdlib PNG decoder (zero deps, PNG-only)
# Animated GIF/WebP/APNG play as ANSI animation (Pillow, else ffmpeg).
# No terminal graphics protocol (kitty/sixel) needed — plain ANSI, works over SSH.
#
set -u
VERSION="1.3.0"

# ---------- defaults ----------
IMAGE=""
WIDTH=40
MODE="half"          # half | full | ascii | mono
CHARSET=' .:-=+*#%@'
COLOR="on"
SHOW_INFO="on"
TEXT_LOGO=""         # distro name for text logo fallback
GAP=4
ANIMATE="auto"       # auto | on | off  (animated GIF/WebP playback)
FPS=""               # target smoothness (frames per second, 1-60, same speed via interpolation)
SPEED=""             # speed multiplier (e.g. 2 = twice as fast, 0.5 = half speed)
LOOPS="0"            # animation loop count (0 = infinite)

BOLD=$'\e[1m'; RESET=$'\e[0m'
C_TITLE=$'\e[1;36m'; C_LABEL=$'\e[1;32m'; C_INFO=$'\e[0m'; C_SEP=$'\e[90m'

# ---------- helpers ----------
die() { printf 'fetch: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
python_has_pil() { python3 -c 'import PIL.Image' >/dev/null 2>&1; }
dbg() { if [[ -n "${FETCH_DEBUG:-}" ]]; then printf 'fetch-debug: %s\n' "$*" >&2; fi; return 0; }

usage() {
  cat <<EOF
custom-fetch v$VERSION — fastfetch-like fetch with zero-setup image support

Usage:
  fetch [OPTIONS] [IMAGE]

Options:
  -i, --image PATH     JPEG/PNG/WebP/GIF/BMP file (or directory: picks first image)
  -w, --width N        ASCII width in chars (default: 40, range 10-200)
  --mode MODE          half (default) | full | ascii | mono
                         half  = ▀ 2 pixels per cell, best fidelity, truecolor
                         full  = █ 1 pixel per cell, tall but vivid
                         ascii = charset-mapped, truecolor
                         mono  = charset-mapped, no color
  --ascii              shortcut for --mode ascii
  --mono               shortcut for --mode mono --color off
  --charset STR        custom charset for ascii/mono (default: ' .:-=+*#%@')
  --color on|off       ANSI colors (default: on)
  --animate            animate GIF/WebP if animated (default when stdout is a TTY)
  --no-animate, --static
                       show first frame only (no animation)
  --fps N              smoothness (1-60 fps, default: native frames).
                       Higher fps = smoother but SAME speed (interpolated).
  --speed M            speed multiplier (e.g. 2 = twice as fast, 0.5 = half
                       speed, default: 1). Combines with --fps.
  --loops N            animation loop count (0 = infinite, default: 0)
  --once               shortcut for --loops 1 (play once, then stop)
  --logo NAME          use built-in text logo instead of image (arch, ubuntu,
                       debian, fedora, archlinux, manjaro, mint, pop, alpine, gentoo)
  --list-logos         list built-in text logos
  --no-info, --image-only   show image only
  --info-only               show system info only
  -h, --help           show this help
  -v, --version        show version

Examples:
  fetch --image photo.jpg
  fetch -i logo.png -w 60 --mode half
  fetch -i pic.jpg --ascii -w 70
  fetch ~/Pictures/wallpaper.png
  fetch --logo arch
  fetch -i anim.gif --animate -w 40       # play animated GIF (loops until Ctrl-C)
  fetch -i anim.gif --once --fps 20       # smoother, same speed, play once
  fetch -i anim.gif --once --fps 20 --speed 2  # smoother + twice as fast

Config (optional): ~/.config/custom-fetch/config
  One KEY=VALUE per line: IMAGE=, WIDTH=, MODE=, CHARSET=, COLOR=,
                          ANIMATE=, FPS=, SPEED=, LOOPS=
EOF
}

list_logos() {
  printf 'built-in logos: arch ubuntu debian fedora manjaro mint pop alpine gentoo nix nixos void generic\n'
}

# ---------- arg parsing ----------
POSITIONAL=""
while (($#)); do
  case "${1:-}" in
    -i|--image) IMAGE="${2:-}"; shift 2 ;;
    --image=*) IMAGE="${1#*=}"; shift ;;
    -w|--width) WIDTH="${2:-}"; shift 2 ;;
    --width=*) WIDTH="${1#*=}"; shift ;;
    --mode) MODE="${2:-}"; shift 2 ;;
    --mode=*) MODE="${1#*=}"; shift ;;
    --charset) CHARSET="${2:-}"; shift 2 ;;
    --charset=*) CHARSET="${1#*=}"; shift ;;
    --color) COLOR="${2:-}"; shift 2 ;;
    --color=*) COLOR="${1#*=}"; shift ;;
    --ascii) MODE="ascii"; shift ;;
    --mono) MODE="mono"; COLOR="off"; shift ;;
    --animate) ANIMATE="on"; shift ;;
    --no-animate|--static) ANIMATE="off"; shift ;;
    --fps) FPS="${2:-}"; shift 2 ;;
    --fps=*) FPS="${1#*=}"; shift ;;
    --speed) SPEED="${2:-}"; shift 2 ;;
    --speed=*) SPEED="${1#*=}"; shift ;;
    --loops) LOOPS="${2:-}"; shift 2 ;;
    --loops=*) LOOPS="${1#*=}"; shift ;;
    --once) LOOPS="1"; shift ;;
    --logo) TEXT_LOGO="${2:-}"; shift 2 ;;
    --logo=*) TEXT_LOGO="${1#*=}"; shift ;;
    --list-logos) list_logos; exit 0 ;;
    --no-info|--image-only) SHOW_INFO="off"; shift ;;
    --info-only) IMAGE=""; TEXT_LOGO="${TEXT_LOGO:-__none__}"; shift ;;
    -h|--help) usage; exit 0 ;;
    -v|--version) printf 'custom-fetch %s\n' "$VERSION"; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown option: $1 (see --help)" ;;
    *) POSITIONAL="$1"; shift ;;
  esac
done
# bare positional arg = image path
if [[ -z "$IMAGE" && -n "$POSITIONAL" ]]; then IMAGE="$POSITIONAL"; fi

# ---------- optional config file ----------
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/custom-fetch/config"
if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  while IFS='=' read -r k v; do
    k="$(printf '%s' "$k" | tr -d '[:space:]')"; v="$(printf '%s' "$v" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [[ "$k" =~ ^#.*$ || -z "$k" ]] && continue
    case "$k" in
      IMAGE) [[ -z "$IMAGE" ]] && IMAGE="$v" ;;
      WIDTH) [[ "$WIDTH" == "40" ]] && WIDTH="$v" ;;
      MODE) [[ "$MODE" == "half" ]] && MODE="$v" ;;
      CHARSET) [[ "$CHARSET" == ' .:-=+*#%@' ]] && CHARSET="$v" ;;
      COLOR) [[ "$COLOR" == "on" ]] && COLOR="$v" ;;
      ANIMATE) [[ "$ANIMATE" == "auto" ]] && ANIMATE="$v" ;;
      FPS) [[ -z "$FPS" ]] && FPS="$v" ;;
      SPEED) [[ -z "$SPEED" ]] && SPEED="$v" ;;
      LOOPS) [[ "$LOOPS" == "0" ]] && LOOPS="$v" ;;
    esac
  done < "$CONFIG_FILE"
fi

# ---------- validation ----------
case "$MODE" in half|full|ascii|mono) ;; *) die "invalid --mode: $MODE (half|full|ascii|mono)" ;; esac
[[ "$MODE" == "mono" ]] && COLOR="off"
if [[ "${NO_COLOR:-}" != "" ]]; then COLOR="off"; fi
if ! [[ "$WIDTH" =~ ^[0-9]+$ ]] || ((WIDTH < 10 || WIDTH > 200)); then die "invalid --width: $WIDTH (10-200)"; fi
if [[ "$COLOR" != "on" && "$COLOR" != "off" ]]; then die "invalid --color: $COLOR (on|off)"; fi
ANIMATE="$(printf '%s' "$ANIMATE" | tr '[:upper:]' '[:lower:]')"
case "$ANIMATE" in auto|on|off) ;; *) die "invalid --animate value: $ANIMATE (auto|on|off, or use --animate/--no-animate)" ;; esac
if [[ -n "$FPS" ]]; then
  if ! [[ "$FPS" =~ ^[0-9]+$ ]] || ((FPS < 1 || FPS > 60)); then die "invalid --fps: $FPS (1-60)"; fi
fi
if [[ -n "$SPEED" ]]; then
  if ! [[ "$SPEED" =~ ^[0-9]*\.?[0-9]+$ ]]; then die "invalid --speed: $SPEED (e.g. 0.5, 1, 2)"; fi
  if ! awk -v s="$SPEED" 'BEGIN{exit !(s>=0.2 && s<=5)}'; then die "invalid --speed: $SPEED (range 0.2-5)"; fi
fi
if ! [[ "$LOOPS" =~ ^[0-9]+$ ]]; then die "invalid --loops: $LOOPS (>=0, 0=infinite)"; fi
if [[ "$COLOR" == "off" ]]; then BOLD=""; RESET=""; C_TITLE=""; C_LABEL=""; C_INFO=""; C_SEP=""; fi

# directory as image source -> pick first image
if [[ -n "$IMAGE" && -d "$IMAGE" ]]; then
  pick="$(find "$IMAGE" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.bmp' \) 2>/dev/null | sort | head -n1)"
  [[ -n "$pick" ]] && IMAGE="$pick" || die "no images found in directory: $IMAGE"
fi
if [[ -n "$IMAGE" ]]; then
  # expand ~ and resolve
  IMAGE="${IMAGE/#\~/$HOME}"
  [[ -f "$IMAGE" ]] || die "image not found: $IMAGE"
fi

# =====================================================================
# SYSTEM INFO (fast, pure bash + std tools)
# =====================================================================
get_os() {
  if [[ -f /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release; printf '%s' "${PRETTY_NAME:-$NAME}"
  else uname -s; fi
}
get_kernel() { uname -r; }
get_arch() { uname -m; }
get_uptime() {
  if [[ -r /proc/uptime ]]; then
    local s; s="$(cut -d. -f1 /proc/uptime)"
    local d=$((s/86400)) h=$(((s%86400)/3600)) m=$(((s%3600)/60))
    ((d>0)) && printf '%dd ' "$d"; ((h>0)) && printf '%dh ' "$h"; printf '%dm' "$m"
  else uptime -p 2>/dev/null | sed 's/^up //' || printf 'unknown'; fi
}
get_shell() {
  local sh="${SHELL:-}"; sh="${sh##*/}"
  [[ -z "$sh" ]] && sh="unknown"
  if [[ "$sh" == "bash" && -n "${BASH_VERSION:-}" ]]; then
    printf 'bash %s' "${BASH_VERSION%%(*}"
  else
    printf '%s' "$sh"
  fi
}
get_de_wm() {
  printf '%s' "${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-${XDG_SESSION_DESKTOP:-unknown}}}"
}
get_term() { printf '%s' "${TERM_PROGRAM:-${TERMINAL:-${TERM:-unknown}}}"; }
get_cpu() {
  local m
  if [[ -r /proc/cpuinfo ]]; then
    m="$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^ *//')"
    printf '%s (%s cores)' "${m:-unknown}" "$(nproc 2>/dev/null || printf '?')"
  else printf '%s' "$(uname -m)"; fi
}
get_gpu() {
  if have lspci; then
    lspci 2>/dev/null | grep -im1 -E 'vga|3d|display' | cut -d: -f3 | sed 's/^ *//' | cut -c1-60
  else printf 'unknown'; fi
}
get_mem() {
  if [[ -r /proc/meminfo ]]; then
    local t a; t="$(awk '/MemTotal/ {print $2}' /proc/meminfo)"; a="$(awk '/MemAvailable/ {print $2}' /proc/meminfo)"
    printf '%dMiB / %dMiB' "$(((t-a)/1024))" "$((t/1024))"
  elif have free; then free -m | awk '/Mem:/ {printf "%dMiB / %dMiB", $3, $2}'; else printf 'unknown'; fi
}
get_disk() {
  df -h / 2>/dev/null | awk 'NR==2 {printf "%s / %s (%s)", $3, $2, $5}' || printf 'unknown'
}
get_pkgs() {
  local n=""
  if have pacman; then n="$(pacman -Qq 2>/dev/null | wc -l) (pacman)"
  elif have dpkg-query; then n="$(dpkg-query -f '.\n' -W 2>/dev/null | wc -l) (dpkg)"
  elif have rpm; then n="$(rpm -qa 2>/dev/null | wc -l) (rpm)"
  elif have apk; then n="$(apk info 2>/dev/null | wc -l) (apk)"
  elif have xbps-query; then n="$(xbps-query -l 2>/dev/null | wc -l) (xbps)"
  elif have emerge; then n="$(ls -d /var/db/pkg/*/* 2>/dev/null | wc -l) (portage)"
  elif have nix-store; then n="$(nix-store -q --requisites /run/current-system/sw 2>/dev/null | wc -l) (nix)"
  else n="unknown"; fi
  printf '%s' "$n"
}
get_host() {
  local h=""; h="$(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null || cat /sys/firmware/devicetree/base/model 2>/dev/null || printf '')"
  printf '%s' "${h:-$(uname -n)}" | tr -d '\0' | cut -c1-60
}

build_info_lines() {
  local user host os sep
  user="$(whoami 2>/dev/null || printf '%s' "$USER")"; host="$(uname -n 2>/dev/null || hostname 2>/dev/null || printf '?')"
  os="$(get_os)"
  sep="$(printf '%*s' "$((${#user}+${#host}+1))" '' | tr ' ' '-')"
  INFO_LINES=(
    "${C_TITLE}${BOLD}${user}@${host}${RESET}"
    "${C_SEP}${sep}${RESET}"
    "${C_LABEL}OS:${RESET} ${C_INFO}${os} $(get_arch)${RESET}"
    "${C_LABEL}Host:${RESET} ${C_INFO}$(get_host)${RESET}"
    "${C_LABEL}Kernel:${RESET} ${C_INFO}$(get_kernel)${RESET}"
    "${C_LABEL}Uptime:${RESET} ${C_INFO}$(get_uptime)${RESET}"
    "${C_LABEL}Shell:${RESET} ${C_INFO}$(get_shell)${RESET}"
    "${C_LABEL}DE:${RESET} ${C_INFO}$(get_de_wm)${RESET}"
    "${C_LABEL}Terminal:${RESET} ${C_INFO}$(get_term)${RESET}"
    "${C_LABEL}CPU:${RESET} ${C_INFO}$(get_cpu)${RESET}"
    "${C_LABEL}GPU:${RESET} ${C_INFO}$(get_gpu)${RESET}"
    "${C_LABEL}Memory:${RESET} ${C_INFO}$(get_mem)${RESET}"
    "${C_LABEL}Disk (/):${RESET} ${C_INFO}$(get_disk)${RESET}"
    "${C_LABEL}Packages:${RESET} ${C_INFO}$(get_pkgs)${RESET}"
    ""
    "$(palette_line)"
  )
}
palette_line() {
  if [[ "$COLOR" == "off" ]]; then printf ''; return; fi
  local s="" i
  for i in 0 1 2 3 4 5 6 7; do s="${s}$(printf '\e[4%dm   ' "$i")"; done
  s="${s}$(printf '\e[0m')"
  printf '%s' "$s"
}

