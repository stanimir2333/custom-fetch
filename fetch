}

# pure-stdlib PNG decoder (no Pillow, no convert/ffmpeg). Handles 8-bit
# non-interlaced RGB/RGBA/palette/gray. Writes ascii to stdout.
render_png_stdlib() {
  local file="$1" w="$2" mode="$3" cs="$4" col="$5"
  python3 - "$file" "$w" "$mode" "$cs" "$col" <<'PYEOF'
import sys, struct, zlib
path, w, mode, charset, col = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4], sys.argv[5]
use_color = (col == "on")
def paeth(a,b,c):
    p=a+b-c; pa,pb,pc=abs(p-a),abs(p-b),abs(p-c)
    if pa<=pb and pa<=pc: return a
    if pb<=pc: return b
    return c
with open(path,'rb') as f:
    sig=f.read(8)
    if sig!=b'\x89PNG\r\n\x1a\n':
        print("fetch: not a PNG file", file=sys.stderr); sys.exit(4)
    ihdr=None; plte=None; idat=b''; trns=None
    while True:
        h=f.read(8)
        if len(h)<8: break
        ln,typ=struct.unpack('>I4s',h)
        data=f.read(ln); crc=f.read(4)
        if typ==b'IHDR': ihdr=data
        elif typ==b'PLTE': plte=data
        elif typ==b'IDAT': idat+=data
        elif typ==b'tRNS': trns=data
        elif typ==b'IEND': break
    if ihdr is None: print("fetch: broken PNG", file=sys.stderr); sys.exit(4)
    W,H,bd,ct,comp,filt,inter=struct.unpack('>IIBBBBB',ihdr)
    if inter!=0: print("fetch: interlaced PNG not supported (install Pillow/Imagemagick)", file=sys.stderr); sys.exit(4)
    if bd!=8: print("fetch: only 8-bit PNG supported without Pillow", file=sys.stderr); sys.exit(4)
    if ct not in (0,2,3,6): print(f"fetch: PNG color type {ct} needs Pillow/Imagemagick", file=sys.stderr); sys.exit(4)
    chmap={0:1,2:3,3:1,6:4}
    ch=chmap[ct]; stride=W*ch
    raw=zlib.decompress(idat)
    rows=[]; prev=bytearray(stride); pos=0
    for y in range(H):
        ftyp=raw[pos]; pos+=1
        cur=bytearray(raw[pos:pos+stride]); pos+=stride
        recon=bytearray(stride)
        if ct in (0,3): bpp=1
        elif ct==2: bpp=3
        else: bpp=4
        for i in range(stride):
            a=recon[i-bpp] if i>=bpp else 0
            b=prev[i]; c=prev[i-bpp] if i>=bpp else 0
            if ftyp==0: v=cur[i]
            elif ftyp==1: v=(cur[i]+a)&255
            elif ftyp==2: v=(cur[i]+b)&255
            elif ftyp==3: v=(cur[i]+((a+b)//2))&255
            elif ftyp==4: v=(cur[i]+paeth(a,b,c))&255
            else: print("fetch: bad PNG filter", file=sys.stderr); sys.exit(4)
            recon[i]=v
        rows.append(bytes(recon)); prev=recon
    # to RGB
    rgb=[]
    pal=[(plte[i],plte[i+1],plte[i+2]) for i in range(0,len(plte or b''),3)] if plte else []
    for y in range(H):
        r=rows[y]; orow=[]
        if ct==2:
            for x in range(W): orow.append((r[x*3],r[x*3+1],r[x*3+2]))
        elif ct==6:
            for x in range(W):
                a=r[x*4+3]/255.0
                orow.append((int(r[x*4]*a),int(r[x*4+1]*a),int(r[x*4+2]*a)))
        elif ct==0:
            for x in range(W): orow.append((r[x],r[x],r[x]))
        elif ct==3:
            for x in range(W):
                idx=r[x]
                orow.append(pal[idx] if idx<len(pal) else (0,0,0))
        rgb.append(orow)
    ow,oh=W,H
    def scale(rows,ow,oh,pw,ph):
        out=[]
        for y in range(ph):
            sy=min(oh-1,int(y*oh/ph)); orow=rows[sy]; nrow=[]
            for x in range(pw):
                sx=min(ow-1,int(x*ow/pw)); nrow.append(orow[sx])
            out.append(nrow)
        return out
    if mode=="half":
        pw=w; ph=max(1,round(w*oh/ow)); px=scale(rgb,ow,oh,pw,ph)
        for y in range(0,ph,2):
            line=[]
            for x in range(pw):
                r1,g1,b1=px[y][x]; r2,g2,b2=px[y+1][x] if y+1<ph else (0,0,0)
                if use_color: line.append(f"\x1b[38;2;{r1};{g1};{b1};48;2;{r2};{g2};{b2}m\u2580\x1b[0m")
                else:
                    l1=0.2126*r1+0.7152*g1+0.0722*b1; l2=0.2126*r2+0.7152*g2+0.0722*b2
                    t1,t2=l1>128,l2>128
                    line.append("\u2588" if (t1 and t2) else ("\u2580" if t1 else ("\u2584" if t2 else " ")))
            print("".join(line))
    elif mode=="full":
        pw=w; ph=max(1,round(w*oh/ow*0.5)); px=scale(rgb,ow,oh,pw,ph)
        for y in range(ph):
            line=[]
            for x in range(pw):
                r,g,b=px[y][x]
                if use_color: line.append(f"\x1b[38;2;{r};{g};{b}m\u2588\x1b[0m")
                else: line.append(charset[int((0.2126*r+0.7152*g+0.0722*b)/255*(len(charset)-1))])
            print("".join(line))
    else:
        pw=w; ph=max(1,round(w*oh/ow*0.5)); px=scale(rgb,ow,oh,pw,ph)
        n=len(charset)
        for y in range(ph):
            line=[]
            for x in range(pw):
                r,g,b=px[y][x]
                ch2=charset[int((0.2126*r+0.7152*g+0.0722*b)/255*(n-1))]
                if use_color: line.append(f"\x1b[38;2;{r};{g};{b}m{ch2}\x1b[0m")
                else: line.append(ch2)
            print("".join(line))
