}

# =====================================================================
# ANIMATED IMAGES (GIF / animated WebP / APNG → terminal animation)
# =====================================================================
# max frames to keep in memory / prerender (sampled evenly if exceeded)
ANIM_MAX_FRAMES=80

is_animated_image() {
  local file="$1"
  if have python3 && python_has_pil; then
    python3 - "$file" <<'PYEOF'
import sys
try:
    from PIL import Image
    im = Image.open(sys.argv[1])
    n = getattr(im, 'n_frames', 1)
    sys.exit(0 if n > 1 else 1)
except SystemExit:
    raise
except Exception:
    sys.exit(2)
PYEOF
    rc=$?
    if [[ $rc -eq 0 ]]; then return 0; fi
    if [[ $rc -eq 1 ]]; then return 1; fi
    # rc==2: PIL couldn't probe, fall through to other detectors
  fi
  if have identify; then
    local n; n="$(identify -format '%n\n' "$file" 2>/dev/null | head -n1)"
    if [[ "$n" =~ ^[0-9]+$ ]] && ((n > 1)); then return 0; fi
    [[ "$n" =~ ^[0-9]+$ ]] && return 1
  fi
  if have magick; then
    local n; n="$(magick identify -format '%n\n' "$file" 2>/dev/null | head -n1)"
    if [[ "$n" =~ ^[0-9]+$ ]] && ((n > 1)); then return 0; fi
    [[ "$n" =~ ^[0-9]+$ ]] && return 1
  fi
  return 1
}

should_animate() {
  local file="$1"
  [[ -n "$file" ]] || { dbg "animate=no (no image)"; return 1; }
  if [[ "$ANIMATE" == "off" ]]; then dbg "animate=no (ANIMATE=off/--static)"; return 1; fi
  if [[ "$ANIMATE" == "auto" ]]; then
    if [[ -t 1 ]]; then dbg "animate check: auto + TTY";
    else dbg "animate=no (auto + not a TTY; use --animate to force)"; return 1; fi
  fi
  # ANIMATE=on forces playback even when piped
  if is_animated_image "$file"; then dbg "animate=yes ($file animated)"; return 0; else dbg "animate=no ($file single-frame)"; return 1; fi
}

# Render all frames via Pillow into $outdir/frame_*.txt + durations.txt + count.txt
# When $FPS_TARGET is set, resamples to that fps preserving total duration
# via blending (smoother, same speed). Otherwise uses native timing.
# Returns 0 if animated (2+ frames), 5 if static (single frame), nonzero on error.
render_animated_pil() {
  local file="$1" w="$2" mode="$3" cs="$4" col="$5" outdir="$6" fps_target="${7:-}"
  mkdir -p "$outdir"
  python3 - "$file" "$w" "$mode" "$cs" "$col" "$outdir" "$ANIM_MAX_FRAMES" "$fps_target" <<'PYEOF'
import sys, os
try:
    from PIL import Image
except ImportError:
    sys.exit(10)
args = sys.argv[1:]
path = args[0]; w = int(args[1]); mode = args[2]; charset = args[3]
col = args[4]; outdir = args[5]; maxf = int(args[6])
fps_s = args[7] if len(args) > 7 else ""
fps_target = int(fps_s) if fps_s.strip().isdigit() else 0
INTERP_MAX = 200
use_color = (col == "on")
try:
    im = Image.open(path)
except Exception as e:
    print(f"fetch: cannot open image: {e}", file=sys.stderr); sys.exit(2)
n = getattr(im, 'n_frames', 1)
if n <= 1:
    sys.exit(5)
ow, oh = im.size
if ow <= 0 or oh <= 0:
    sys.exit(2)
if mode == "half":
    pw = w; ph = max(1, round(w * oh / ow))
else:
    pw = w; ph = max(1, round(w * oh / ow * 0.5))

def to_rgb(frame):
    if frame.mode in ("RGBA", "LA"):
        bg = Image.new("RGB", frame.size, (0, 0, 0))
        bg.paste(frame.convert("RGB"), mask=frame.split()[-1])
        return bg
    if "transparency" in frame.info:
        try:
            rgba = frame.convert("RGBA")
            bg = Image.new("RGB", frame.size, (0, 0, 0))
            bg.paste(rgba.convert("RGB"), mask=rgba.split()[-1])
            return bg
        except Exception:
            return frame.convert("RGB")
    return frame.convert("RGB")

def render_small(sml):
    # sml is already pw x ph RGB; emits minimal ANSI (only on color change)
    px = sml.load()
    lines = []
    if mode == "half":
        for y in range(0, ph, 2):
            parts = []
            cur = None
            for x in range(pw):
                r1, g1, b1 = px[x, y]
                if y + 1 < ph:
                    r2, g2, b2 = px[x, y + 1]
                else:
                    r2, g2, b2 = (0, 0, 0)
                if use_color:
                    key = (r1, g1, b1, r2, g2, b2)
                    if key != cur:
                        parts.append(f"\x1b[38;2;{r1};{g1};{b1};48;2;{r2};{g2};{b2}m")
                        cur = key
                    parts.append("\u2580")
                else:
                    l1 = 0.2126*r1+0.7152*g1+0.0722*b1
                    l2 = 0.2126*r2+0.7152*g2+0.0722*b2
                    t1, t2 = l1 > 128, l2 > 128
                    if t1 and t2: ch = "\u2588"
                    elif t1: ch = "\u2580"
                    elif t2: ch = "\u2584"
                    else: ch = " "
                    parts.append(ch)
            if use_color and cur is not None:
                parts.append("\x1b[0m")
            lines.append("".join(parts))
    elif mode == "full":
        for y in range(ph):
            parts = []
            cur = None
            for x in range(pw):
                r, g, b = px[x, y]
                if use_color:
                    key = (r, g, b)
                    if key != cur:
                        parts.append(f"\x1b[38;2;{r};{g};{b}m")
                        cur = key
                    parts.append("\u2588")
                else:
                    lum = 0.2126*r+0.7152*g+0.0722*b
                    parts.append(charset[int(lum/255*(len(charset)-1))])
            if use_color and cur is not None:
                parts.append("\x1b[0m")
            lines.append("".join(parts))
    else:
        nn = len(charset)
        for y in range(ph):
            parts = []
            cur = None
            for x in range(pw):
                r, g, b = px[x, y]
                lum = 0.2126*r+0.7152*g+0.0722*b
                ch = charset[int(lum/255*(nn-1))]
                if use_color:
                    key = (r, g, b)
                    if key != cur:
                        parts.append(f"\x1b[38;2;{r};{g};{b}m")
                        cur = key
                    parts.append(ch)
                else:
                    parts.append(ch)
            if use_color and cur is not None:
                parts.append("\x1b[0m")
            lines.append("".join(parts))
    return lines

def write_frame(idx, sml, dur):
    lines = render_small(sml)
    with open(os.path.join(outdir, f"frame_{idx:03d}.txt"), "w", encoding="utf-8") as f:
        for ln in lines:
            f.write(ln + "\n")
    return str(dur)

# collect natives as small RGB (fast blend + low memory), sequential for disposal
natives = []
native_durs = []
for i in range(n):
    try:
        im.seek(i)
    except EOFError:
        break
    dur = im.info.get("duration", 100)
    try:
        dur = int(dur)
    except Exception:
        dur = 100
    if dur < 20:
        dur = 100
    rgb = to_rgb(im)
    if rgb.size != (pw, ph):
        rgb = rgb.resize((pw, ph), Image.LANCZOS)
    natives.append(rgb)
    native_durs.append(dur)
if len(natives) <= 1:
    sys.exit(5)

if fps_target and fps_target > 0:
    D = sum(native_durs)
    if D <= 0:
        D = len(natives) * 100
    M = int(round(D * fps_target / 1000))
    M = max(2, min(INTERP_MAX, M))
    uni = int(round(D / M))  # preserves total duration even when capped
    if uni < 1:
        uni = 1
    # cumulative timeline
    cum = [0]
    for d in native_durs:
        cum.append(cum[-1] + d)
    durs = []
    N = len(natives)
    # linear scan pointer (N small)
    for j in range(M):
        t = j * D / M
        k = 0
        # find interval k with cum[k] <= t < cum[k+1]
        for kk in range(N):
            if cum[kk] <= t < cum[kk+1]:
                k = kk
                break
            if t >= cum[N]:
                k = N - 1
        dk = native_durs[k] if native_durs[k] > 0 else 1
        alpha = (t - cum[k]) / dk
        if alpha < 0.02:
            out = natives[k]
        elif alpha > 0.98:
            out = natives[(k + 1) % N]
        else:
            a = natives[k]
            b = natives[(k + 1) % N]
            if a.size != b.size:
                b = b.resize(a.size, Image.BILINEAR)
            try:
                out = Image.blend(a, b, float(alpha))
            except Exception:
                out = a
        durs.append(write_frame(j, out, uni))
    count = M
else:
    # native timing, sample evenly when too many frames
    N = len(natives)
    if N > maxf:
        step = N / maxf
        idxs = [int(i * step) for i in range(maxf)]
        scale = N / maxf
    else:
        idxs = list(range(N))
        scale = 1.0
    durs = []
    for c, idx in enumerate(idxs):
        d = int(round(native_durs[idx] * scale))
        durs.append(write_frame(c, natives[idx], d))
    count = len(idxs)
if count <= 1:
    sys.exit(5)
with open(os.path.join(outdir, "durations.txt"), "w") as f:
    f.write("\n".join(durs) + "\n")
with open(os.path.join(outdir, "count.txt"), "w") as f:
    f.write(str(count) + "\n")
PYEOF
}

# Fallback frame extraction via ffmpeg (no Pillow): dumps PPMs then renders each.
# When $FPS_TARGET is set, resamples preserving duration via blending (same speed).
# Native delays unknown → assumes 100ms each.
render_animated_ffmpeg() {
  local file="$1" w="$2" mode="$3" cs="$4" col="$5" outdir="$6" fps_target="${7:-$FPS}"
  mkdir -p "$outdir"
  local ppm_tmp="$outdir/ppm"
  mkdir -p "$ppm_tmp"
  if ! ffmpeg -y -loglevel error -i "$file" -vf "scale='min(320\,iw)':-1" "$ppm_tmp/f_%03d.ppm" 2>/dev/null; then
    return 1
  fi
  python3 - "$ppm_tmp" "$w" "$mode" "$cs" "$col" "$outdir" "$ANIM_MAX_FRAMES" "$fps_target" <<'PYEOF'
import sys, os, glob
ppmdir, w, mode, charset, col, outdir, maxf_s, fps_s = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6], sys.argv[7], (sys.argv[8] if len(sys.argv) > 8 else "")
maxf = int(maxf_s)
fps_target = int(fps_s) if fps_s.strip().isdigit() else 0
INTERP_MAX = 200
use_color = (col == "on")
def parse_ppm(path):
    with open(path, 'rb') as f:
        data = f.read()
    i = 0; nn = len(data)
    def next_token():
        nonlocal i
        while i < nn:
            if data[i:i+1] == b'#':
                while i < nn and data[i:i+1] != b'\n': i += 1
                continue
            if chr(data[i]) in ' \t\n\r':
                i += 1; continue
            break
        j = i
        while j < nn and chr(data[j]) not in ' \t\n\r': j += 1
        tok = data[i:j].decode('ascii'); i = j
        return tok
    magic = next_token()
    if magic != 'P6':
        raise ValueError(f"unsupported {magic}")
    W = int(next_token()); H = int(next_token()); mx = int(next_token())
    i += 1
    raw = data[i:i+W*H*3]
    rows = []
    p = 0
    for y in range(H):
        row = []
        for x in range(W):
            row.append((raw[p], raw[p+1], raw[p+2])); p += 3
        rows.append(row)
    return W, H, rows
def scale_nearest(rows, ow, oh, pw, ph):
    out = []
    for y in range(ph):
        sy = min(oh-1, int(y*oh/ph)); orow = rows[sy]; nrow = []
        for x in range(pw):
            sx = min(ow-1, int(x*ow/pw)); nrow.append(orow[sx])
        out.append(nrow)
