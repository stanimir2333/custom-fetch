# =====================================================================
# IMAGE → ASCII (embedded python, multi-backend)
# =====================================================================
render_image_pil() {
  # args: file width mode charset color(on/off)
  local file="$1" w="$2" mode="$3" cs="$4" col="$5"
  python3 - "$file" "$w" "$mode" "$cs" "$col" <<'PYEOF'
import sys
try:
    from PIL import Image
except ImportError:
    sys.exit(10)
path, w, mode, charset, col = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4], sys.argv[5]
use_color = (col == "on")
im = Image.open(path)
# composite transparency onto black
if im.mode in ("RGBA", "LA"):
    bg = Image.new("RGB", im.size, (0, 0, 0))
    bg.paste(im.convert("RGB") if im.mode=="RGBA" else im.convert("RGB"), mask=im.split()[-1])
    im = bg
else:
    im = im.convert("RGB")
ow, oh = im.size
if ow <= 0 or oh <= 0:
    sys.exit(2)
if mode == "half":
    pw = w
    ph = max(1, round(w * oh / ow))
    im = im.resize((pw, ph), Image.LANCZOS)
    px = im.load()
    for y in range(0, ph, 2):
        line = []
        for x in range(pw):
            r1,g1,b1 = px[x, y]
            if y+1 < ph:
                r2,g2,b2 = px[x, y+1]
            else:
                r2,g2,b2 = (0,0,0)
            if use_color:
                line.append(f"\x1b[38;2;{r1};{g1};{b1};48;2;{r2};{g2};{b2}m\u2580\x1b[0m")
            else:
                l1 = 0.2126*r1+0.7152*g1+0.0722*b1
                l2 = 0.2126*r2+0.7152*g2+0.0722*b2
                t1, t2 = l1>128, l2>128
                if t1 and t2: ch="\u2588"
                elif t1: ch="\u2580"
                elif t2: ch="\u2584"
                else: ch=" "
                line.append(ch)
        print("".join(line))
elif mode == "full":
    pw = w
    ph = max(1, round(w * oh / ow * 0.5))
    im = im.resize((pw, ph), Image.LANCZOS)
    px = im.load()
    for y in range(ph):
        line=[]
        for x in range(pw):
            r,g,b = px[x,y]
            if use_color:
                line.append(f"\x1b[38;2;{r};{g};{b}m\u2588\x1b[0m")
            else:
                lum = 0.2126*r+0.7152*g+0.0722*b
                idx = int(lum/255*(len(charset)-1))
                line.append(charset[idx])
        print("".join(line))
else:  # ascii / mono
    pw = w
    ph = max(1, round(w * oh / ow * 0.5))
    im = im.resize((pw, ph), Image.LANCZOS)
    px = im.load()
    n = len(charset)
    for y in range(ph):
        line=[]
        for x in range(pw):
            r,g,b = px[x,y]
            lum = 0.2126*r+0.7152*g+0.0722*b
            idx = int(lum/255*(n-1))
            ch = charset[idx]
            if use_color:
                line.append(f"\x1b[38;2;{r};{g};{b}m{ch}\x1b[0m")
            else:
                line.append(ch)
        print("".join(line))
PYEOF
}

# stdlib renderer: reads PPM (P6) from a file, scales + renders. No Pillow needed.
# (takes a file path — not stdin — because the python code itself arrives via heredoc stdin)
render_ppm_file() {
  # args: ppmfile width mode charset color
  local ppmfile="$1" w="$2" mode="$3" cs="$4" col="$5"
  python3 - "$ppmfile" "$w" "$mode" "$cs" "$col" <<'PYEOF'
import sys
ppmpath, w, mode, charset, col = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4], sys.argv[5]
use_color = (col == "on")
with open(ppmpath, 'rb') as f:
    data = f.read()
# --- parse P6 PPM ---
def parse_ppm(d):
    # returns (W,H,pixels list of rows of (r,g,b))
    i = 0
    n = len(d)
    def next_token():
        nonlocal i
        while i < n:
            if d[i:i+1] == b'#':
                while i < n and d[i:i+1] != b'\n': i += 1
                continue
            if chr(d[i]) in ' \t\n\r':
                i += 1; continue
            break
        j = i
        while j < n and chr(d[j]) not in ' \t\n\r': j += 1
        tok = d[i:j].decode('ascii'); i = j
        return tok
    magic = next_token()
    if magic not in ('P6',):
        print(f"fetch: unsupported pipe format {magic}", file=sys.stderr); sys.exit(3)
    W = int(next_token()); H = int(next_token()); mx = int(next_token())
    i += 1  # single whitespace after maxval
    if mx != 255:
        print("fetch: only maxval 255 supported", file=sys.stderr); sys.exit(3)
    need = W*H*3
    raw = d[i:i+need]
    if len(raw) < need:
        print("fetch: truncated image data", file=sys.stderr); sys.exit(3)
    rows = []
    p = 0
    for y in range(H):
        row = []
        for x in range(W):
            row.append((raw[p], raw[p+1], raw[p+2])); p += 3
        rows.append(row)
    return W, H, rows
ow, oh, rows = parse_ppm(data)
def scale_nearest(rows, ow, oh, pw, ph):
    out = []
    for y in range(ph):
        sy = min(oh-1, int(y*oh/ph))
        orow = rows[sy]
        nrow = []
        for x in range(pw):
            sx = min(ow-1, int(x*ow/pw))
            nrow.append(orow[sx])
        out.append(nrow)
    return out
if mode == "half":
    pw = w; ph = max(1, round(w*oh/ow))
    px = scale_nearest(rows, ow, oh, pw, ph)
    for y in range(0, ph, 2):
        line=[]
        for x in range(pw):
            r1,g1,b1 = px[y][x]
            r2,g2,b2 = px[y+1][x] if y+1<ph else (0,0,0)
            if use_color:
                line.append(f"\x1b[38;2;{r1};{g1};{b1};48;2;{r2};{g2};{b2}m\u2580\x1b[0m")
            else:
                l1=0.2126*r1+0.7152*g1+0.0722*b1; l2=0.2126*r2+0.7152*g2+0.0722*b2
                t1,t2 = l1>128, l2>128
                ch = "\u2588" if (t1 and t2) else ("\u2580" if t1 else ("\u2584" if t2 else " "))
                line.append(ch)
        print("".join(line))
elif mode == "full":
    pw=w; ph=max(1, round(w*oh/ow*0.5))
    px=scale_nearest(rows,ow,oh,pw,ph)
    for y in range(ph):
        line=[]
        for x in range(pw):
            r,g,b=px[y][x]
            if use_color: line.append(f"\x1b[38;2;{r};{g};{b}m\u2588\x1b[0m")
            else:
                lum=0.2126*r+0.7152*g+0.0722*b
                line.append(charset[int(lum/255*(len(charset)-1))])
        print("".join(line))
else:
    pw=w; ph=max(1, round(w*oh/ow*0.5))
    px=scale_nearest(rows,ow,oh,pw,ph)
    n=len(charset)
    for y in range(ph):
        line=[]
        for x in range(pw):
            r,g,b=px[y][x]
            lum=0.2126*r+0.7152*g+0.0722*b
            ch=charset[int(lum/255*(n-1))]
            if use_color: line.append(f"\x1b[38;2;{r};{g};{b}m{ch}\x1b[0m")
            else: line.append(ch)
        print("".join(line))
PYEOF
}

# pure-stdlib PNG decoder (no Pillow, no convert/ffmpeg). Handles 8-bit
# non-interlaced RGB/RGBA/palette/gray. Writes ascii to stdout.
render_png_stdlib() {
  local file="$1" w="$2" mode="$3" cs="$4" col="$5"
  python3 - "$file" "$w" "$mode" "$cs" "$col" <<'PYEOF'
import sys, struct, zlib
path, w, mode, charset, col = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4], sys.argv[5]
use_color = (col == "on")
def paeth(a,b,c):
    p=a+b-c; pa,pb,pc=abs(p-a),abs(p-b),abs(p-c)
    if pa<=pb and pa<=pc: return a
    if pb<=pc: return b
    return c
with open(path,'rb') as f:
    sig=f.read(8)
    if sig!=b'\x89PNG\r\n\x1a\n':
        print("fetch: not a PNG file", file=sys.stderr); sys.exit(4)
    ihdr=None; plte=None; idat=b''; trns=None
    while True:
        h=f.read(8)
        if len(h)<8: break
        ln,typ=struct.unpack('>I4s',h)
        data=f.read(ln); crc=f.read(4)
        if typ==b'IHDR': ihdr=data
        elif typ==b'PLTE': plte=data
        elif typ==b'IDAT': idat+=data
        elif typ==b'tRNS': trns=data
        elif typ==b'IEND': break
    if ihdr is None: print("fetch: broken PNG", file=sys.stderr); sys.exit(4)
    W,H,bd,ct,comp,filt,inter=struct.unpack('>IIBBBBB',ihdr)
    if inter!=0: print("fetch: interlaced PNG not supported (install Pillow/Imagemagick)", file=sys.stderr); sys.exit(4)
    if bd!=8: print("fetch: only 8-bit PNG supported without Pillow", file=sys.stderr); sys.exit(4)
    if ct not in (0,2,3,6): print(f"fetch: PNG color type {ct} needs Pillow/Imagemagick", file=sys.stderr); sys.exit(4)
    chmap={0:1,2:3,3:1,6:4}
    ch=chmap[ct]; stride=W*ch
    raw=zlib.decompress(idat)
    rows=[]; prev=bytearray(stride); pos=0
    for y in range(H):
        ftyp=raw[pos]; pos+=1
        cur=bytearray(raw[pos:pos+stride]); pos+=stride
        recon=bytearray(stride)
        if ct in (0,3): bpp=1
        elif ct==2: bpp=3
        else: bpp=4
        for i in range(stride):
            a=recon[i-bpp] if i>=bpp else 0
            b=prev[i]; c=prev[i-bpp] if i>=bpp else 0
            if ftyp==0: v=cur[i]
            elif ftyp==1: v=(cur[i]+a)&255
            elif ftyp==2: v=(cur[i]+b)&255
            elif ftyp==3: v=(cur[i]+((a+b)//2))&255
            elif ftyp==4: v=(cur[i]+paeth(a,b,c))&255
            else: print("fetch: bad PNG filter", file=sys.stderr); sys.exit(4)
            recon[i]=v
        rows.append(bytes(recon)); prev=recon
    # to RGB
    rgb=[]
    pal=[(plte[i],plte[i+1],plte[i+2]) for i in range(0,len(plte or b''),3)] if plte else []
    for y in range(H):
        r=rows[y]; orow=[]
        if ct==2:
            for x in range(W): orow.append((r[x*3],r[x*3+1],r[x*3+2]))
        elif ct==6:
            for x in range(W):
                a=r[x*4+3]/255.0
                orow.append((int(r[x*4]*a),int(r[x*4+1]*a),int(r[x*4+2]*a)))
        elif ct==0:
            for x in range(W): orow.append((r[x],r[x],r[x]))
        elif ct==3:
            for x in range(W):
                idx=r[x]
                orow.append(pal[idx] if idx<len(pal) else (0,0,0))
        rgb.append(orow)
    ow,oh=W,H
    def scale(rows,ow,oh,pw,ph):
        out=[]
        for y in range(ph):
            sy=min(oh-1,int(y*oh/ph)); orow=rows[sy]; nrow=[]
            for x in range(pw):
                sx=min(ow-1,int(x*ow/pw)); nrow.append(orow[sx])
            out.append(nrow)
        return out
    if mode=="half":
        pw=w; ph=max(1,round(w*oh/ow)); px=scale(rgb,ow,oh,pw,ph)
        for y in range(0,ph,2):
            line=[]
            for x in range(pw):
                r1,g1,b1=px[y][x]; r2,g2,b2=px[y+1][x] if y+1<ph else (0,0,0)
                if use_color: line.append(f"\x1b[38;2;{r1};{g1};{b1};48;2;{r2};{g2};{b2}m\u2580\x1b[0m")
                else:
                    l1=0.2126*r1+0.7152*g1+0.0722*b1; l2=0.2126*r2+0.7152*g2+0.0722*b2
                    t1,t2=l1>128,l2>128
                    line.append("\u2588" if (t1 and t2) else ("\u2580" if t1 else ("\u2584" if t2 else " ")))
            print("".join(line))
    elif mode=="full":
        pw=w; ph=max(1,round(w*oh/ow*0.5)); px=scale(rgb,ow,oh,pw,ph)
        for y in range(ph):
            line=[]
            for x in range(pw):
                r,g,b=px[y][x]
                if use_color: line.append(f"\x1b[38;2;{r};{g};{b}m\u2588\x1b[0m")
                else: line.append(charset[int((0.2126*r+0.7152*g+0.0722*b)/255*(len(charset)-1))])
            print("".join(line))
    else:
        pw=w; ph=max(1,round(w*oh/ow*0.5)); px=scale(rgb,ow,oh,pw,ph)
        n=len(charset)
        for y in range(ph):
            line=[]
            for x in range(pw):
                r,g,b=px[y][x]
                ch2=charset[int((0.2126*r+0.7152*g+0.0722*b)/255*(n-1))]
                if use_color: line.append(f"\x1b[38;2;{r};{g};{b}m{ch2}\x1b[0m")
                else: line.append(ch2)
            print("".join(line))
PYEOF
}

# main dispatcher: prints ascii art to stdout, returns 0 on success
print_image_ascii() {
  local file="$1"
  local ext="${file##*.}"; ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
  local col="$COLOR"; [[ "$MODE" == "mono" ]] && col="off"

  # 1) Pillow — best path, all formats
  if have python3 && python_has_pil; then
    if render_image_pil "$file" "$WIDTH" "$MODE" "$CHARSET" "$col"; then return 0; fi
    rc=$?; [[ $rc -eq 10 ]] || return $rc   # real render error: don't silently fall through
  fi

  # 2) ImageMagick / ffmpeg -> PPM file -> stdlib renderer (handles JPG+PNG, no Pillow)
  if have python3; then
    local _ppm=""; _ppm="$(mktemp --suffix=.ppm 2>/dev/null || mktemp)"
    # shellcheck disable=SC2064
    trap "rm -f '$_ppm'" RETURN
    if have magick; then
      if magick "$file" -resize '320x320>' "ppm:$_ppm" 2>/dev/null && render_ppm_file "$_ppm" "$WIDTH" "$MODE" "$CHARSET" "$col"; then rm -f "$_ppm"; trap - RETURN; return 0; fi
    elif have convert; then
      # cap source at 320px to keep things fast; stdlib python rescales to WIDTH
      if convert "$file" -resize '320x320>' "ppm:$_ppm" 2>/dev/null && render_ppm_file "$_ppm" "$WIDTH" "$MODE" "$CHARSET" "$col"; then rm -f "$_ppm"; trap - RETURN; return 0; fi
    fi
    if have ffmpeg; then
      if ffmpeg -y -loglevel error -i "$file" -vframes 1 -vf "scale='min(320\,iw)':-1" -f image2 -vcodec ppm "$_ppm" 2>/dev/null && render_ppm_file "$_ppm" "$WIDTH" "$MODE" "$CHARSET" "$col"; then rm -f "$_ppm"; trap - RETURN; return 0; fi
    fi
    rm -f "$_ppm"; trap - RETURN
  fi

  # 3) pure-stdlib PNG (zero deps)
  if [[ "$ext" == "png" ]] && have python3; then
    if render_png_stdlib "$file" "$WIDTH" "$MODE" "$CHARSET" "$col"; then return 0; fi
    return $?
  fi

  # 4) external ascii tools as last resort
  if have chafa; then
    local args=(--format symbols --symbols block --size "${WIDTH}x")
    [[ "$col" == "off" ]] && args+=(--color-space mono)
    chafa "${args[@]}" "$file" 2>/dev/null && return 0
  fi
  if have jp2a; then
    [[ "$col" == "off" ]] && jp2a --width="$WIDTH" "$file" 2>/dev/null && return 0
    jp2a --colors --width="$WIDTH" "$file" 2>/dev/null && return 0
  fi

  die "cannot decode '$file'. Install one of: python3-pillow, imagemagick, ffmpeg."
}

# =====================================================================
# MAIN RENDER
# =====================================================================
main() {
  local -a ART=()
  local art_width="$WIDTH"

  if [[ -n "$IMAGE" && "$SHOW_INFO" != "off" || -n "$IMAGE" ]]; then :; fi

  if [[ -n "$IMAGE" ]]; then
    # capture rendered lines preserving ANSI
    tmp="$(mktemp)"
    if ! print_image_ascii "$IMAGE" > "$tmp"; then rm -f "$tmp"; exit 1; fi
    mapfile -t ART < "$tmp"
    rm -f "$tmp"
    art_width="$WIDTH"
  elif [[ -n "$TEXT_LOGO" && "$TEXT_LOGO" != "__none__" ]]; then
    tmp="$(mktemp)"
    get_text_logo "$TEXT_LOGO" > "$tmp"
    mapfile -t ART < "$tmp"
    rm -f "$tmp"
    # visible width of text logo = longest line without ANSI
    art_width=0
    for l in "${ART[@]}"; do
      plain="$(printf '%s' "$l" | sed -e 's/\x1b\[[0-9;]*m//g')"
      (( ${#plain} > art_width )) && art_width=${#plain}
    done
  elif [[ "${TEXT_LOGO:-}" == "__none__" ]]; then
    ART=(); art_width=0
  else
    tmp="$(mktemp)"
    get_text_logo "$(detect_distro_logo)" > "$tmp"
    mapfile -t ART < "$tmp"
    rm -f "$tmp"
    art_width=0
    for l in "${ART[@]}"; do
      plain="$(printf '%s' "$l" | sed -e 's/\x1b\[[0-9;]*m//g')"
      (( ${#plain} > art_width )) && art_width=${#plain}
    done
  fi

  if [[ "$SHOW_INFO" == "off" ]]; then
    printf '%s\n' "${ART[@]}"
    return 0
  fi

  build_info_lines

  local n_art=${#ART[@]} n_info=${#INFO_LINES[@]}
  local n=$(( n_art > n_info ? n_art : n_info ))
  local gap; gap="$(printf '%*s' "$GAP" '')"
  local i a inf pad
  for ((i=0; i<n; i++)); do
    a=""; inf=""
    (( i < n_art )) && a="${ART[i]}"
    (( i < n_info )) && inf="${INFO_LINES[i]}"
    if (( art_width == 0 )); then
      printf '%b\n' "$inf"
    elif [[ -z "$a" ]]; then
      pad="$(printf '%*s' "$art_width" '')"
      if [[ -z "$inf" ]]; then printf '\n'; else printf '%s%s%b\n' "$pad" "$gap" "$inf"; fi
    else
      if [[ -z "$inf" ]]; then printf '%b\n' "$a"
      else printf '%b%s%b\n' "$a" "$gap" "$inf"; fi
    fi
  done
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
